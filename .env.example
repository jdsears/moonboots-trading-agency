# MoonBoots Trading Agency - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# API Keys (Required)
# ===========================================

# Anthropic API Key - Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# 0x Protocol API Key - Get from https://0x.org/docs
ZEROX_API_KEY=your-0x-api-key

# WalletConnect Project ID - Get from https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your-project-id

# ===========================================
# Fee Configuration
# ===========================================

# Treasury wallet address for fee collection
FEE_RECIPIENT_ADDRESS=0xYourTreasuryAddress

# Base trading fee in basis points (50 = 0.5%)
TRADING_FEE_BPS=50

# Percentage of fees allocated to MBDAO buybacks (50 = 50%)
MBDAO_BUYBACK_PERCENTAGE=50

# Minimum USD threshold to trigger buyback
BUYBACK_THRESHOLD_USD=100

# ===========================================
# NFT Contract Addresses (Base Mainnet)
# ===========================================

# MoonBoots MB1 NFT Collection
MOONBOOTS_MB1_CONTRACT=0x...

# Chappyz NFT Collection (alternative access)
CHAPPYZ_CONTRACT=0x...

# MBDAO VIP NFT Collection (20% fee discount)
MBDAO_VIP_CONTRACT=0x...

# MBDAO Token Address on Base
MBDAO_TOKEN_ADDRESS=0x0dd7913197bfb6d2b1f03f9772ced06298f1a644

# ===========================================
# Admin Wallet (Required for Buybacks)
# ===========================================

# Hot wallet private key for executing buybacks
# SECURITY WARNING: Use a dedicated wallet with limited funds only!
# Never use your main wallet or store large amounts here
ADMIN_WALLET_PRIVATE_KEY=0x...

# ===========================================
# Server Configuration
# ===========================================

# Server port (backend)
PORT=3001

# Environment (development/production)
NODE_ENV=development

# Frontend URL for CORS (update in production)
FRONTEND_URL=http://localhost:5173

# Backend API URL (for frontend)
VITE_API_URL=http://localhost:3001

# ===========================================
# Rate Limiting (Optional)
# ===========================================

# Maximum requests per window
RATE_LIMIT_MAX=100

# Rate limit window in milliseconds (60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
